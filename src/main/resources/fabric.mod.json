{
  "schemaVersion": 1,
  "id": "safetravel",
  "version": "${version}",
  "name": "SafeTravel",
  "description": "Fly to a destination with the Elytra and Baritone, then get boxed in Netherrack for safety.",
  "authors": [
    "adriabama06"
  ],
  "contact": {
    "sources": "https://github.com/adriabama06/safetravel-minecraft"
  },
  "icon": "assets/safetravel/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "io.adriabama06.safetravel.SafeTravelAddon"
    ]
  },
  "mixins": [
    "safetravel.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "225,25,25",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  }
}